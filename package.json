{
  "name": "agent-swarm-codex-guardian",
  "version": "1.0.0",
  "description": "Production-grade multi-agent AI framework with scientific methodology",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:security": "jest tests/security",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "example:spawn-cohort": "ts-node examples/spawn-4-agent-cohort.example.ts",
    "benchmark": "ts-node src/cli/benchmark.ts",
    "report:security": "ts-node src/cli/report-security.ts",
    "report:performance": "ts-node src/cli/report-performance.ts"
  },
  "keywords": [
    "ai",
    "agents",
    "multi-agent",
    "anthropic",
    "typescript",
    "scientific-method"
  ],
  "author": "Codex Guardian",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
